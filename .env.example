# Panel de control (http://localhost:PORT)
PORT=3000
ADMIN_USER=admin
ADMIN_PASSWORD=cambia-esta-contraseña

# Ollama (IA local)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Clave JSON de la cuenta de servicio de Google (Calendar + Sheets)
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./credentials/google-key.json

# Números que pueden hablar con negocios en modo "test" (formato internacional sin +, separados por comas)
ALLOWED_TEST_NUMBERS=34600111222

# Almacenamiento local
DATABASE_FILE=./data/bot.db
SESSIONS_DIR=./sessions

# Mensajes recientes que se envían al modelo (el resto se resume)
HISTORY_MESSAGES=20

# trace | debug | info | warn | error | fatal
LOG_LEVEL=info
