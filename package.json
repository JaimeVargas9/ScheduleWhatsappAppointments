{
  "name": "whatsapp-citas-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "db:generate": "drizzle-kit generate",
    "seed": "tsx scripts/seed.ts",
    "tenant:create": "tsx scripts/tenant-create.ts",
    "gdpr:delete": "tsx scripts/gdpr-delete.ts",
    "probar:ia": "tsx scripts/probar-ia.ts"
  },
  "dependencies": {
    "@googleapis/calendar": "^20.1.0",
    "@googleapis/sheets": "^18.1.1",
    "@hono/node-server": "^2.1.5",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "fullcalendar": "^6.1.22",
    "hono": "^4.13.14",
    "luxon": "^3.7.2",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "qrcode": "^1.5.4",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/luxon": "^3.7.6",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
